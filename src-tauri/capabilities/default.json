{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "default",
  "description": "Default capabilities for MaduReader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "core:window:allow-create",
    "core:window:allow-get-all-windows",
    "log:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-open",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-open"
  ]
}
