{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaduReader",
  "version": "0.1.0",
  "identifier": "com.shichao402.madureader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:17973",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ma读",
        "width": 1320,
        "height": 920,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
